<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to PH Healthcare</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif;">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="width:100%; background-color:#f4f7fb; padding:40px 15px;"
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          style="
            max-width:600px;
            background-color:#ffffff;
            border-radius:12px;
            overflow:hidden;
            border:1px solid #e5e7eb;
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                background-color:#0f766e;
                padding:35px 30px;
                text-align:center;
              "
            >
              <h1
                style="
                  margin:0;
                  color:#ffffff;
                  font-size:30px;
                  font-weight:700;
                "
              >
                PH Healthcare
              </h1>

              <p
                style="
                  margin:8px 0 0;
                  color:#d1fae5;
                  font-size:14px;
                "
              >
                Your Health, Our Priority
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:40px 35px;">

              <h2
                style="
                  margin:0 0 20px;
                  color:#111827;
                  font-size:26px;
                  text-align:center;
                "
              >
                Welcome to PH Healthcare!
              </h2>

              <p
                style="
                  margin:0 0 20px;
                  color:#374151;
                  font-size:15px;
                  line-height:1.7;
                "
              >
                Hello <strong><%= name %></strong>,
              </p>

              <p
                style="
                  margin:0 0 20px;
                  color:#4b5563;
                  font-size:15px;
                  line-height:1.7;
                "
              >
                Welcome to PH Healthcare! Your account has been
                successfully created.
              </p>

              <p
                style="
                  margin:0 0 25px;
                  color:#4b5563;
                  font-size:15px;
                  line-height:1.7;
                "
              >
                We're happy to have you as part of our community.
                PH Healthcare is designed to make managing your healthcare
                experience easier, more convenient, and more accessible.
              </p>

              <!-- Welcome Box -->
              <div
                style="
                  background-color:#f0fdfa;
                  border-radius:10px;
                  padding:22px;
                  margin:25px 0;
                  text-align:center;
                "
              >
                <p
                  style="
                    margin:0;
                    color:#115e59;
                    font-size:16px;
                    line-height:1.7;
                    font-weight:600;
                  "
                >
                  We're glad you're here!
                </p>

                <p
                  style="
                    margin:8px 0 0;
                    color:#4b5563;
                    font-size:14px;
                    line-height:1.6;
                  "
                >
                  Your healthcare journey with us starts now.
                </p>
              </div>

              <p
                style="
                  margin:0 0 20px;
                  color:#4b5563;
                  font-size:15px;
                  line-height:1.7;
                "
              >
                Thank you for choosing PH Healthcare. We look forward
                to providing you with a better healthcare experience.
              </p>

              <p
                style="
                  margin:25px 0 0;
                  color:#4b5563;
                  font-size:14px;
                  line-height:1.6;
                "
              >
                Best regards,<br />
                <strong>PH Healthcare Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              style="
                background-color:#f9fafb;
                padding:20px 30px;
                text-align:center;
              "
            >
              <p
                style="
                  margin:0 0 8px;
                  color:#6b7280;
                  font-size:12px;
                "
              >
                © 2026 PH Healthcare. All rights reserved.
              </p>

              <p
                style="
                  margin:0;
                  color:#9ca3af;
                  font-size:11px;
                "
              >
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>